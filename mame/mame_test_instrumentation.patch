+//-------------------------------------------------
+//  test_overclock - opt-in test knob: environment
+//  variable MAME_CPU_OVERCLOCK=":tag=factor[,...]"
+//  multiplies a device's clock (used by the
+//  CPS15_to_CPS2 logic-equivalence harness only)
+//-------------------------------------------------
+
+static double test_overclock(const char *tag)
+{
+	const char *env = std::getenv("MAME_CPU_OVERCLOCK");
+	if (!env)
+		return 1.0;
+	std::string spec(env);
+	size_t pos = 0;
+	while (pos < spec.size())
+	{
+		size_t end = spec.find(',', pos);
+		std::string item = spec.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+		size_t eq = item.find('=');
+		if (eq != std::string::npos && item.substr(0, eq) == tag)
+			return std::atof(item.c_str() + eq + 1);
+		if (end == std::string::npos)
+			break;
+		pos = end + 1;
+	}
+	return 1.0;
+}
